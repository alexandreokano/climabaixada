name: Atualizar cptec.json

on:
  schedule:
    - cron: '17 */3 * * *'   # a cada 3 horas (UTC)
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: cptec
  cancel-in-progress: false

jobs:
  cptec:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Buscar ondas e vento do CPTEC
        run: node atualizar-cptec.mjs
        env:
          OUT: cptec.json
      - name: Salvar se mudou
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add cptec.json
          if git diff --cached --quiet; then echo "Sem mudanças."; exit 0; fi
          git commit -m "chore: atualiza cptec.json"
          for i in 1 2 3; do
            git pull --rebase && git push && exit 0
            sleep 5
          done
          exit 1
